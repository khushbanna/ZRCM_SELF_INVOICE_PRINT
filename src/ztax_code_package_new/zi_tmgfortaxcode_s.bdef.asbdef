managed with additional save implementation in class ZBP_I_TMGFORTAXCODE_S unique;
strict;
with draft;
define behavior for ZI_TmgForTaxCode_S alias TmgForTaxCodeAll
draft table ZTAX_CODE_N_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )
{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _TmgForTaxCode { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }

}

define behavior for ZI_TmgForTaxCode alias TmgForTaxCode ##UNMAPPED_FIELD
persistent table ZTAX_CODE_NEW
draft table ZTAX_CODE_NEW_D
lock dependent by _TmgForTaxCodeAll
authorization dependent by _TmgForTaxCodeAll
{
  field ( mandatory : create )
   Taxcode,
   Transactionkey,
   ConditionType;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Taxcode,
   Transactionkey,
   ConditionType;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  mapping for ZTAX_CODE_NEW
  {
    Taxcode = TAXCODE;
    Transactionkey = TRANSACTIONKEY;
    ConditionType = CONDITION_TYPE;
    Taxcodedescription = TAXCODEDESCRIPTION;
    Gstrate = GSTRATE;
  }

  association _TmgForTaxCodeAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }

}